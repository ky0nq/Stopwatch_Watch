`timescale 1ns / 1ps

module tb_watch_top ();

    reg        clk;
    reg        rst;
    reg  [2:0] sw;
    reg        btnR;
    reg        btnL;
    reg        btnU;
    reg        btnD;
    wire [6:0] msec_wt;
    wire [5:0] sec_wt;
    wire [5:0] min_wt;
    wire [4:0] hour_wt;
    wire       o_led2;
    wire       o_led1;
    wire [3:0] o_led_wt_set;

    parameter SEC_DELAY = 1_000_000;
    parameter MIN_DELAY = 60_000_000;

    watch_top dut (
        .clk         (clk),
        .rst         (rst),
        .sw          (sw),
        .btnR        (btnR),
        .btnL        (btnL),
        .btnU        (btnU),
        .btnD        (btnD),
        .msec_wt     (msec_wt),
        .sec_wt      (sec_wt),
        .min_wt      (min_wt),
        .hour_wt     (hour_wt),
        .o_led2      (o_led2),
        .o_led1      (o_led1),
        .o_led_wt_set(o_led_wt_set)
    );

always #5 clk = ~clk;

initial begin
    clk = 0;
    rst = 1;
    sw = 3'b010; // 시계-시간모드
    btnR    = 0;
    btnL    = 0;
    btnU    = 0;
    btnD    = 0;

    @(negedge clk);
    @(negedge clk);
    @(negedge clk);
    rst = 0;
    @(negedge clk);
    @(negedge clk);

    repeat (10) #(SEC_DELAY);
    sw = 3'b110; // 시계 - 설정모드
    
    @(negedge clk);
    @(negedge clk);
    @(negedge clk);
    @(negedge clk);
    
    @(negedge clk);
    @(negedge clk);
    @(negedge clk);
    @(negedge clk);
    #25;
    // hour -> min : right
    btnR = 1;
    #10;
    btnR = 0;
    #10;
    // min -> sec : right
    btnR = 1;
    #10;
    btnR = 0;
    #10;

    btnU = 1;
    #10;
    btnU = 0;

    @(negedge clk);
    @(negedge clk);
    @(negedge clk);
    @(negedge clk);


    @(negedge clk);
    @(negedge clk);
    @(negedge clk);
    @(negedge clk);
    @(negedge clk);


    #(SEC_DELAY);

    #(MIN_DELAY);

    $stop;
end


endmodule
