`timescale 1ns / 1ps

module tb_watch_top ();

    reg        clk;
    reg        rst;
    reg  [2:0] sw;
    reg        btnR;
    reg        btnL;
    reg        btnU;
    reg        btnD;
    wire [6:0] msec_wt;
    wire [5:0] sec_wt;
    wire [5:0] min_wt;
    wire [4:0] hour_wt;
    wire       o_led2;
    wire       o_led1;
    wire [3:0] o_led_wt_set;

    parameter SEC_DELAY = 1_000_000;
    parameter MIN_DELAY = 60_000_000;

    watch_top dut (
        .clk         (clk),
        .rst         (rst),
        .sw          (sw),
        .btnR        (btnR),
        .btnL        (btnL),
        .btnU        (btnU),
        .btnD        (btnD),
        .msec_wt     (msec_wt),
        .sec_wt      (sec_wt),
        .min_wt      (min_wt),
        .hour_wt     (hour_wt),
        .o_led2      (o_led2),
        .o_led1      (o_led1),
        .o_led_wt_set(o_led_wt_set)
    );

    always #5 clk = ~clk;

    initial begin
        clk  = 0;
        rst  = 1;
        sw   = 3'b010;

        btnR = 0;
        btnL = 0;
        btnU = 0;
        btnD = 0;

        @(negedge clk);
        @(negedge clk);
        @(negedge clk);
        rst = 0;
        @(negedge clk);
        @(negedge clk);
        // 시계 시간모드 sec.msec
        sw   = 3'b010;
        @(negedge clk);
        @(negedge clk);
        @(negedge clk);
        @(negedge clk);
        @(negedge clk);
        @(negedge clk);
        // 시계 시간모드 hour.min
        sw   = 3'b011;
        @(negedge clk);
        @(negedge clk);
        // button에 대한 영향 존재 확인
        btnU = 1;
        #80_000;

        btnU = 0;
        @(negedge clk);
        @(negedge clk);
        @(negedge clk);
        @(negedge clk);
        @(negedge clk);
        @(negedge clk);
        @(negedge clk);

        #(SEC_DELAY);

        $stop;
    end


endmodule
