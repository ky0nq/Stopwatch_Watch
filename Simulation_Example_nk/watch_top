`timescale 1ns / 1ps

module watch_top (
    input       clk,
    input       rst,
    input [2:0] sw,
    input       btnR,
    input       btnL,
    input       btnU,
    input       btnD,

    output [6:0] msec_wt,
    output [5:0] sec_wt,
    output [5:0] min_wt,
    output [4:0] hour_wt,

    output       o_led2,
    output       o_led1,
    output [3:0] o_led_wt_set
);
    parameter   MSEC_WIDTH =    7,
                SEC_WIDTH  =    6,
                MIN_WIDTH  =    6,
                HOUR_WIDTH =    5,
                MSEC_INIT =     0,
                SEC_INIT  =     0,
                MIN_INIT  =     0,
                HOUR_INIT =     12;

    wire w_down, w_up;
    wire [3:0] w_place;

    // watch
    control_unit_watch U_CNT_WATCH (
        .clk         (clk),
        .rst         (rst),
        .display     (sw[1]),
        .i_left      (btnL),
        .i_right     (btnR),
        .sw          (sw),
        .o_place     (w_place),
        .o_led2      (o_led2),
        .o_led1      (o_led1),
        .o_led_wt_set(o_led_wt_set)
    );

    watch_datapath #(
        .MSEC_WIDTH(MSEC_WIDTH),
        .SEC_WIDTH (SEC_WIDTH),
        .MIN_WIDTH (MIN_WIDTH),
        .HOUR_WIDTH(HOUR_WIDTH),
        .MSEC_INIT (MSEC_INIT),
        .SEC_INIT  (SEC_INIT),
        .MIN_INIT  (MIN_INIT),
        .HOUR_INIT (HOUR_INIT)
    ) U_WATCH_DATAPATH (
        .clk      (clk),
        .rst      (rst),
        .sw2_and_1(sw[2] & sw[1]),
        .place    (w_place),
        .i_up     (btnU),
        .i_down   (btnD),
        .msec     (msec_wt),
        .sec      (sec_wt),
        .min      (min_wt),
        .hour     (hour_wt)
    );

endmodule
