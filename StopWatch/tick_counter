//7. sw[1]에 대한 시간 설정 모드 추가 x


`timescale 1ns / 1ps

module tick_counter #(
    parameter   TIMES = 100,
                BIT_WIDTH = 7
) (
    input                        clk,
    input                        rst,
    input                        i_tick,
    
    input                        i_clear,
    input                        i_mode,

    output     [BIT_WIDTH - 1:0] times_counter,
    output reg                   o_tick
);

    //counter register SL
    reg [BIT_WIDTH-1:0] counter_reg, counter_next;
    assign times_counter = counter_reg;

    always @(posedge clk, posedge rst) begin
        if (rst) begin
            counter_reg <= 0;
        end else begin
            counter_reg <= counter_next;
        end
    end

    // next counter CL
    always @(*) begin
        counter_next = counter_reg;
        o_tick = 1'b0;
        if (i_tick) begin
            // output : next , input : current
            if (i_mode) begin
                counter_next = counter_reg - 1;
                if (counter_reg == (TIMES -1)) begin
                    o_tick          = 1'b1;
                    counter_next    = TIMES - 1;
                end
                else begin 
                    o_tick = 1'b0;
                end
            end
            else begin // up count
                counter_next = counter_reg + 1;
                if (counter_reg == 0) begin
                    counter_next    = 0;
                    o_tick          = 1'b1;
                end
                else begin
                    o_tick = 1'b0;
                end
            end 
        end
        else if (i_clear) begin
            counter_next = 0;
            o_tick       = 1'b0;
        end
    end

endmodule
