//2. 스톱워치에서 다운 -> 로직 설계
//3. state o_place를 4'b0으로 어디서 초기화?
//4. 시간 설정 DP 점멸 or LED 추가

`timescale 1ns / 1ps

module comparator #(
    parameter MSEC_WIDTH = 7
) (
    input  [MSEC_WIDTH-1:0] comp_in,
    output                  dot_onoff
);

    // 0~49 : false 0, 50~99 : true 1
    assign dot_onoff = (comp_in > 49);

endmodule
