`timescale 1ns / 1ps

module top_stopwatch(
    input           clk,
    input           rst,
    input   [1:0]   sw,
    input           sw9,
    input           btnR,
    input           btnL,
    input           btnU,
    input           btnD,

    output  [7:0]   fnd_data,
    output  [3:0]   fnd_com
    );
    
    parameter   MSEC_WIDTH =    7,
                SEC_WIDTH  =    6,
                MIN_WIDTH  =    6,
                HOUR_WIDTH =    5,
                MSEC_SET   =    0,  
                SEC_SET    =    0,  
                MIN_SET    =    0,  
                HOUR_SET   =    8;

    wire   [MSEC_WIDTH-1 : 0]  w_msec;
    wire   [ SEC_WIDTH-1 : 0]  w_sec;
    wire   [ MIN_WIDTH-1 : 0]  w_min;
    wire   [HOUR_WIDTH-1 : 0]  w_hour;

    wire   [MSEC_WIDTH-1 : 0]  w_fnd_msec;
    wire   [ SEC_WIDTH-1 : 0]  w_fnd_sec;
    wire   [ MIN_WIDTH-1 : 0]  w_fnd_min;
    wire   [HOUR_WIDTH-1 : 0]  w_fnd_hour;

    wire    w_btnR, w_btnL, w_btnD, w_btnU;
    wire    w_runstop, w_clear, w_mode, w_set;

    // 시계 설정 모드를 위한 위치 정보
    wire [3:0] w_place;
    button_debounce U_BTNR(
        .clk            (clk),
        .rst            (rst),
        .i_Btn          (btnR),
        .o_Btn          (w_btnR)
    );

    button_debounce U_BTNL(
        .clk            (clk),
        .rst            (rst),
        .i_Btn          (btnL),
        .o_Btn          (w_btnL)
    );

    button_debounce U_BTND(
        .clk            (clk),
        .rst            (rst),
        .i_Btn          (btnD),
        .o_Btn          (w_btnD)
    );

    button_debounce U_BTNU(
        .clk            (clk),
        .rst            (rst),
        .i_Btn          (btnU),
        .o_Btn          (w_btnU)
    );

    // stopwatch
    control_unit_stopwatch U_CONTROL_UNIT (
        .clk            (clk),
        .rst            (rst),
        .display        (~sw[1]),
        .i_runstop      (w_btnR),   
        .i_clear        (w_btnL),    
        .i_mode         (w_btnD),
        .i_set          (w_btnU),   
        .o_runstop      (w_runstop),
        .o_clear        (w_clear),
        .o_mode         (w_mode),
        .o_set          (w_set)   
    );

    stopwatch_datapath  #(
        .MSEC_WIDTH (MSEC_WIDTH),
        .SEC_WIDTH  (SEC_WIDTH),
        .MIN_WIDTH  (MIN_WIDTH),
        .HOUR_WIDTH (HOUR_WIDTH),
        .MSEC_SET   (MSEC_SET),
        .SEC_SET    (SEC_SET),
        .MIN_SET    (MIN_SET),
        .HOUR_SET   (HOUR_SET)
    ) U_STOPWATCH_DATAPATH(
        .clk            (clk),
        .rst            (rst),
        .i_runstop      (w_runstop),
        .i_clear        (w_clear),
        .i_mode         (w_mode),
        .i_set          (w_set),    
        .msec           (w_msec),
        .sec            (w_sec),
        .min            (w_min),
        .hour           (w_hour)
    );

    fnd_controller U_FND_CNTL (
        .clk            (clk),
        .rst            (rst),
        .sw0            (sw[0]),
        .sw1            (sw[1]),
        .sw9            (sw9),
        .msec           (w_msec),
        .sec            (w_sec),
        .min            (w_min),
        .hour           (w_hour),
        .fnd_com        (fnd_com),
        .fnd_data       (fnd_data)
    );

endmodule
