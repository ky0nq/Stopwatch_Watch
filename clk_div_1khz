//2. 스톱워치에서 run을 누르면 바로 run 동작 안함
//3. led 불 1,2번이 안들어옴
//4. 시간 설정을 가서 업다운은 되는데 왼오 동작이 안됨
//5. 왼오를 누르면 그 후에 업다운이 안됨
//6. 스톱워치에서 다운누르고 오른쪽 누르면 07.11 , 11.03까지만 나옴 그리고 멈춤
//7. sw[1]에 대한 시간 설정 모드 추가 x

`timescale 1ns / 1ps

module clk_div_1khz (
	input		clk,
	input		rst,

	output		o_1khz
	);
	reg	[15:0]	counter_reg;
	reg		o_1khz_reg;

	assign 	o_1khz = o_1khz_reg;

	always @(posedge clk, posedge rst) begin
		if (rst) begin
			counter_reg <= 16'b0;
			o_1khz_reg <= 1'b0;
		end 
		else begin
			counter_reg <= counter_reg + 1;
			if (counter_reg == (50_000 - 1)) begin 
				o_1khz_reg <= ~o_1khz_reg;
			end
		end
	end

endmodule
