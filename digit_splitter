`timescale 1ns / 1ps

module digit_splitter # (
    parameter BIT_WIDTH = 7
)(
    input [BIT_WIDTH-1:0] digit_in,

    output [3:0] digit_1,
    output [3:0] digit_10
);

    assign digit_1 = digit_in % 10;
    assign digit_10 = (digit_in / 10) % 10;

endmodule
