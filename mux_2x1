//1. 시간 설정을 가서 sec 부분에서 Left, Right 동작 x
//2. 스톱워치에서 다운 -> 로직 설계
//3. state o_place를 4'b0으로 어디서 초기화?
//4. 시간 설정 DP 점멸 or LED 추가
`timescale 1ns / 1ps
module mux_2x1 # (
    parameter BIT_WIDTH = 4
)(
    input   [BIT_WIDTH-1:0]   in0,
    input   [BIT_WIDTH-1:0]   in1,
    input                     sel,
    output  [BIT_WIDTH-1:0]   out_mux
    );

    assign out_mux = (sel) ? in1 : in0;

endmodule
