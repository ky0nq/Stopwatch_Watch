//1. led 불 1,2번이 안들어옴
//2. 시간 설정을 가서 업다운, 왼오 동작이 안됨
//3. 스톱워치에서 다운 -> 로직 설계
//4. 시간 설정 모드에서 DP 켜거나 LED

`timescale 1ns / 1ps
// 시계할 때 복잡하면 control unit 분리해서 2개로 설계
module control_unit_watch ( // moore machine
    input                   clk,
    input                   rst,
    input                   display, // sw[1]

	input 	                i_left,   
    input                   i_right,    
    input                   i_down,  
    input                   i_up, 
    input       [2:0]       sw,
	 
    output  reg             o_down,  
    output  reg             o_up, 
    output  reg [3:0]       o_place,

    output      [1:0]       o_led 
    );

    reg [2:0] c_state, n_state, prev_state;
    parameter RUN = 3'b000, SET = 3'b001, HOUR = 3'b010, MIN = 3'b011, SEC = 3'b100, MSEC = 3'b101, PLACE = 3'b110;

    assign o_led[0] = sw[1]; 
    assign o_led[1] = sw[2]; 

    // state register 
    always @(posedge clk, posedge rst) begin
        if (rst) begin
            c_state <= RUN;
            prev_state <= RUN;
        end
        else begin
            c_state <= n_state;
            prev_state <= c_state;
        end
    end

    // next, output CL
    always @(*) begin
        n_state = c_state; // 질문~ : 어디서 초기화 해야해?
        o_up   = 1'b0; 
        o_down = 1'b0;
        /* o_place = 4'b0000; jimin */
        if (display) begin // 버튼 공유하고 있으니까 watch를 보고 있을 때만 버튼을 반영
            case (c_state)
                RUN : begin
                    o_place  = 4'b0000; /*nk*/
                    o_up     = 1'b0;    /*nk*/
                    o_down   = 1'b0;    /*nk*/
                    if (sw[1] & sw[2]) begin // 시계 - 설정모드
                        n_state = SET;
                    end
                    else begin // 시계 - 시간
                        n_state = c_state;
                    end
                end
                SET: begin
                    o_place  = 3'b0; /*nk*/
                    o_up     = 1'b0; /*nk*/
                    o_down   = 1'b0; /*nk*/
                    if ((!sw[1]) | (!sw[2])) begin // 시계 - 시간 or 스톱워치 - (시계 - 설정)
                       n_state = RUN; 
                    end
                    else begin
                        n_state = HOUR; 
                    end
                end
                HOUR: begin
                    if ((!sw[1]) | (!sw[1])) begin
                        n_state = RUN;
                    end
                    else if (i_left) begin 
                        n_state = MSEC;
                    end
                    else if (i_right) begin
                        n_state = MIN;
                    end
                    else if (i_up | i_down) begin  
                        n_state = PLACE;
                    end
                    else begin          
                        n_state = c_state;
                    end
                end
                MIN: begin
                    if ((!sw[1]) | (!sw[1])) begin
                        n_state = RUN;
                    end
                    else if (i_left) begin 
                        n_state = HOUR;
                    end
                    else if (i_right) begin
                        n_state = SEC;
                    end
                    else if (i_up | i_down) begin  
                        n_state = PLACE;
                    end
                    else begin          
                        n_state = c_state;
                    end
                end
                SEC: begin
                    if ((!sw[1]) | (!sw[1])) begin
                        n_state = RUN;
                    end
                    else if (i_left) begin 
                        n_state = MIN;
                    end
                    else if (i_right) begin
                        n_state = MSEC;
                    end
                    else if (i_up | i_down) begin  
                        n_state = PLACE;
                    end
                    else begin          
                        n_state = c_state;
                    end
                end
                MSEC: begin
                    if ((!sw[1]) | (!sw[1])) begin
                        n_state = RUN;
                    end
                    else if (i_left) begin 
                        n_state = SEC;
                    end
                    else if (i_right) begin
                        n_state = HOUR;
                    end
                    else if (i_up | i_down) begin  
                        n_state = PLACE;
                    end
                    else begin          
                        n_state = c_state;
                    end
                end
                PLACE : begin
                    if ((!sw[1]) | (!sw[2])) begin 
                        n_state = RUN;
                    end
                    else begin 
                        case (prev_state)
                            HOUR: begin
                                o_place = 4'b1000;
                                n_state = HOUR;
                            end
                            MIN: begin
                                o_place = 4'b0100;
                                n_state = MIN;
                            end
                            SEC: begin
                                o_place = 4'b0010;
                                n_state = SEC;
                            end
                            MSEC: begin
                                o_place = 4'b0001;
                                n_state = MSEC;
                            end
                            default: begin
                                n_state = SET;
                                o_place = 4'b0000;
                            end
                        endcase
                        if (i_up) begin
                            o_up = 1'b1;
                        end 
                        else if (i_down) begin
                            o_down = 1'b1;
                        end 
                        else begin
                            n_state = c_state;
                        end 
                    end
                end
            endcase
        end
        else begin
            n_state = c_state;
        end
    end
endmodule
