// 26.04.21 FSM 수정

`timescale 1ns / 1ps

module control_unit_watch ( 
    input                   clk,
    input                   rst,
    input                   display, // 현재 어떤 모드를 보여주고 있는지 sw[1] 연결
                                     // display = 0 : stopwatch , display = 1 : watch

	input 	                i_left,   
    input                   i_right,    

    input       [2:0]       sw,
	 
    output  reg [3:0]       o_place, // 시계 - 설정 모드일 때 tick_counter 에 어떤 시간 단위 (위치)를 변경할건지 알려주기 위한 위치 정보
    output                  o_led2,
    output                  o_led1,
    output      [3:0]       o_led_wt_set // 시계 설정 모드 중 현재 위치 표시를 위한 LED
        );

    reg [2:0] c_state, n_state;
    parameter RUN = 3'b000, HOUR = 3'b001, MIN = 3'b010, SEC = 3'b011, MSEC = 3'b100;

    assign o_led1 = sw[1]; 
    assign o_led2 = sw[2]; 

     // 시계 설정 모드에서 설정 위치 표시
    assign o_led_wt_set = ((sw == 3'b110) && (o_place == 4'b0001)) ? 4'b0011 : 
                            ((sw == 3'b110) && (o_place == 4'b0010)) ? 4'b1100 :
                                ((sw == 3'b111) && (o_place == 4'b0100)) ? 4'b0011 :
                                    ((sw == 3'b111) && (o_place == 4'b1000)) ? 4'b1100 : 4'b0000;
                                    
    // state register 
    always @(posedge clk, posedge rst) begin
        if (rst) begin
            c_state <= RUN;
        end
        else begin
            c_state <= n_state;
        end
    end

    // next state CL (combinational)
    always @(*) begin
        n_state = c_state;
        if (display) begin
            case (c_state)
                RUN : begin
                    if (sw[1] & sw[2]) n_state = HOUR;
                    else               n_state = RUN;
                end
                HOUR: begin
                    if ((!sw[1]) | (!sw[2]))  n_state = RUN;
                    else if (i_left)          n_state = MSEC;
                    else if (i_right)         n_state = MIN;
                    else                      n_state = HOUR;
                end
                MIN: begin
                    if ((!sw[1]) | (!sw[2]))  n_state = RUN;
                    else if (i_left)          n_state = HOUR;
                    else if (i_right)         n_state = SEC;
                    else                      n_state = MIN;
                end
                SEC: begin
                    if ((!sw[1]) | (!sw[2]))  n_state = RUN;
                    else if (i_left)          n_state = MIN;
                    else if (i_right)         n_state = MSEC;
                    else                      n_state = SEC;
                end
                MSEC: begin
                    if ((!sw[1]) | (!sw[2]))  n_state = RUN;
                    else if (i_left)          n_state = SEC;
                    else if (i_right)         n_state = HOUR;
                    else                      n_state = MSEC;
                end
            endcase
        end
        else begin
            n_state = c_state;
        end
    end

    // output CL - c_state 기반으로 o_place 결정 (registered output)
    always @(*) begin
        case (c_state)
            RUN  : o_place = 4'b0000;
            HOUR : o_place = 4'b1000;
            MIN  : o_place = 4'b0100;
            SEC  : o_place = 4'b0010;
            MSEC : o_place = 4'b0001;
            default: o_place = 4'b0000;
        endcase
    end
endmodule
