`timescale 1ns / 1ps

module control_unit_watch ( 
    input                   clk,
    input                   rst,
    input                   display, // 현재 어떤 모드를 보여주고 있는지 sw[1] 연결
                                     // display = 0 : stopwatch , display = 1 : watch

	input 	                i_left,   
    input                   i_right,    

    input       [2:0]       sw,
	 
    output  reg [3:0]       o_place, // 시계 - 설정 모드일 때 tick_counter 에 어떤 시간 단위 (위치)를 변경할건지 알려주기 위한 위치 정보
    output                  o_led2,
    output                  o_led1,
    output      [3:0]       o_led_wt_set // 시계 설정 모드 중 현재 위치 표시를 위한 LED
        );

    reg [2:0] c_state, n_state;
    parameter RUN = 3'b000, HOUR = 3'b001, MIN = 3'b010, SEC = 3'b011, MSEC = 3'b100;

    assign o_led1 = sw[1]; 
    assign o_led2 = sw[2]; 

     // 시계 설정 모드에서 설정 위치 표시
    assign o_led_wt_set = ((sw == 3'b110) && (o_place == 4'b0001)) ? 4'b0011 : 
                            ((sw == 3'b110) && (o_place == 4'b0010)) ? 4'b1100 :
                                ((sw == 3'b111) && (o_place == 4'b0100)) ? 4'b0011 :
                                    ((sw == 3'b111) && (o_place == 4'b1000)) ? 4'b1100 : 4'b0000;
                                    
    // state register 
    always @(posedge clk, posedge rst) begin
        if (rst) begin
            c_state <= RUN;
        end
        else begin
            c_state <= n_state;
        end
    end

    // next, output CL
    always @(*) begin
        n_state = c_state; 
        o_place = 4'b0000;
        if (display) begin // 버튼 공유하고 있으니까 watch를 보고 있을 때만 버튼을 반영
            case (c_state)
                RUN : begin
                    o_place  = 4'b0000; 
                    if (sw[1] & sw[2]) begin // 시계 - 설정모드
                        n_state = HOUR;
                        o_place = 4'b1000;
                    end 
                    else begin // 시계 - 시간
                        n_state = c_state;
                    end
                end
                HOUR: begin
                    // 시계 - 시간모드 or 시계 - 설정 모드 이지만 stopwatch로 넘어갔을 때
                    if ((!sw[1]) | (!sw[2])) begin 
                        n_state = RUN; // 설정하고 있다가 스톱워치가도 우리는 시간을 고정안하고 흐르게 한다
                        o_place  = 4'b0000; 
                    end
                    else if (i_left) begin 
                        n_state = MSEC;
                        o_place = 4'b0001;
                    end
                    else if (i_right) begin
                        n_state = MIN;
                        o_place = 4'b0100;
                    end
                    else begin          
                        n_state = c_state;
                        o_place = 4'b1000;
                    end
                end
                MIN: begin
                    if ((!sw[1]) | (!sw[2])) begin
                        n_state = RUN;
                        o_place  = 4'b0000; 
                    end
                    else if (i_left) begin 
                        n_state = HOUR;
                        o_place = 4'b1000;
                    end
                    else if (i_right) begin
                        n_state = SEC;
                        o_place = 4'b0010;
                    end 
                    else begin          
                        n_state = c_state;
                        o_place = 4'b0100;
                    end
                end
                SEC: begin
                    if ((!sw[1]) | (!sw[2])) begin
                        n_state = RUN;
                        o_place  = 4'b0000; 
                    end
                    else if (i_left) begin 
                        n_state = MIN;
                        o_place = 4'b0100;
                    end
                    else if (i_right) begin
                        n_state = MSEC;
                        o_place = 4'b0001;
                    end 
                    else begin          
                        n_state = c_state;
                        o_place = 4'b0010;
                    end
                end
                MSEC: begin
                    if ((!sw[1]) | (!sw[2])) begin
                        n_state = RUN;
                        o_place  = 4'b0000; 
                    end
                    else if (i_left) begin 
                        n_state = SEC;
                        o_place = 4'b0010;
                    end
                    else if (i_right) begin
                        n_state = HOUR;
                        o_place = 4'b1000;
                    end
                    else begin          
                        n_state = c_state;
                        o_place = 4'b0001;
                    end
                end
            endcase
        end
        else begin // 스톱워치 모드일 때 계속 실행되도록
            n_state = c_state;
            o_place  = 4'b0000; 
        end
    end
endmodule
