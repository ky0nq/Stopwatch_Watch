//3. 스톱워치에서 다운 -> 로직 설계
//4. 시간 설정 모드에서 DP 켜거나 LED

`timescale 1ns / 1ps

module tick_gen_100hz_watch (
    input       clk,
    input       rst,
    input       sw,

    output reg  o_tick_100hz

);
    // 100Hz counter number * 1000 for simulation
    parameter F_COUNT = 100_000_000 / 100;
    reg [$clog2(F_COUNT)-1:0] counter_reg;  

    always @(posedge clk, posedge rst) begin
        if (rst) begin
            counter_reg     <= 0;
            o_tick_100hz    <= 1'b0;
        end 
        else begin
            if (!sw) begin 
                counter_reg     <= counter_reg + 1;
                o_tick_100hz    <= 1'b0;
                if (counter_reg == F_COUNT - 1) begin
                    counter_reg     <= 0;
                    o_tick_100hz    <= 1'b1;
                end else begin 
                    o_tick_100hz    <= 1'b0;
                end
            end
            else begin
                counter_reg     <= 0;
                o_tick_100hz    <= 1'b0;
            end
        end
    end
endmodule
