//2. 스톱워치에서 다운 -> 로직 설계
//3. state o_place를 4'b0으로 어디서 초기화?
//4. 시간 설정 DP 점멸 or LED 추가

`timescale 1ns / 1ps

module decoder_2x4 (
    input [1:0] decoder_in,

    output reg [3:0] fnd_com
);

    always @(*) begin
        case (decoder_in)
            2'b00:   fnd_com = 4'b1110;
            2'b01:   fnd_com = 4'b1101;
            2'b10:   fnd_com = 4'b1011;
            2'b11:   fnd_com = 4'b0111;
            default: fnd_com = 4'b1111;
        endcase
    end

endmodule
